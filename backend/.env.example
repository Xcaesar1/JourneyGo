# Local backend configuration. Copy to .env; never commit filled values.
# Complete feature/key examples: ../docs/API_KEYS.md.
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
DEMO_MODE=false
PLANNER_ENGINE=journey_graph

# Model provider credentials; leave secrets blank until configured.
LLM_API_KEY=
# Example: LLM_API_KEY=replace-with-your-model-api-key
LLM_BASE_URL=https://your-model-provider.example/v1
LLM_MODEL_ID=your-model-id
LLM_TIMEOUT=180

# Match your local PostgreSQL instance; this password is a placeholder.
DATABASE_URL=postgresql+psycopg://journeygo:replace-with-database-password@localhost:5432/journeygo
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Server-side AMap Web Service key, not a frontend build variable.
VITE_AMAP_WEB_KEY=
# Example: VITE_AMAP_WEB_KEY=replace-with-amap-web-service-key
# Browser map credentials; configure allowed domains in the provider console.
VITE_AMAP_WEB_JS_KEY=
VITE_AMAP_SECURITY_JS_CODE=
AMAP_PERSONAL_MAP_ENABLED=false

# Read-only travel providers. Flight queries remain separately gated.
ONE_CLICK_TRAVEL_ENABLED=false
TRAVEL_TRAIN_ENABLED=false
TRAVEL_HOTEL_ENABLED=false
ROLLINGGO_API_KEY=
# Example: ROLLINGGO_API_KEY=replace-with-rollinggo-hotel-key
TRAVEL_FLIGHT_ENABLED=false
VARIFLIGHT_API_KEY=
# Example: VARIFLIGHT_API_KEY=replace-with-variflight-key
TRAVEL_FLIGHT_CALL_LIMIT=0
WEATHER_ENABLED=false

API_ACCESS_CODE_REQUIRED=true
API_ACCESS_CODE=
# Example: API_ACCESS_CODE=replace-with-your-random-access-code
RUNTIME_SECRET_UPDATES_ENABLED=false
API_DOCS_ENABLED=true

# Optional research/map providers, not required for the keyless Demo.
BRAVE_SEARCH_API_KEY=
TRIPAI_ENABLED=false
TRIPAI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PROXY=
# XHS compatibility settings are inactive; no Cookie is required.
