# Copy to .env.staging on the staging host. Never commit populated values.
# Key requirements and placeholder examples: docs/API_KEYS.md.
IMAGE_TAG=latest
LLM_API_KEY=
# Example: LLM_API_KEY=replace-with-your-model-api-key
LLM_BASE_URL=https://your-model-provider.example/v1
LLM_MODEL_ID=your-model-id
LLM_TIMEOUT=180
LLM_STRUCTURED_MAX_TOKENS=32768
LLM_STRUCTURED_MAX_ATTEMPTS=2
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
LLM_MAX_TOKENS_PER_TRIP=80000
LLM_MAX_COST_PER_TRIP_USD=2.0
DEMO_MODE=false
API_DOCS_ENABLED=false
RUNTIME_SECRET_UPDATES_ENABLED=false
API_ACCESS_CODE_REQUIRED=false
# Populate in the untracked environment before enabling API_ACCESS_CODE_REQUIRED.
API_ACCESS_CODE=
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=6
API_RATE_LIMIT_WINDOW_SECONDS=60
API_MAX_ACTIVE_TRIP_TASKS=4
API_MAX_REQUEST_BYTES=32768
LEGACY_JSON_REPAIR=true
PLANNER_ENGINE=legacy
PLANNER_COMPARE_ENGINES=false
TRIP_PLANNER_TIMEOUT=420
VITE_AMAP_WEB_KEY=
# Server-only Web Service key, despite the historical VITE_ variable name.
# Example: VITE_AMAP_WEB_KEY=replace-with-amap-web-service-key
VITE_AMAP_WEB_JS_KEY=
# Browser-visible Web JS key; restrict to your allowed site domains.
# Example: VITE_AMAP_WEB_JS_KEY=replace-with-amap-browser-js-key
VITE_AMAP_SECURITY_JS_CODE=
# Example: VITE_AMAP_SECURITY_JS_CODE=replace-with-amap-browser-security-code
AMAP_PERSONAL_MAP_ENABLED=false
TRIPAI_ENABLED=false
TRIPAI_API_KEY=
# Optional: TRIPAI_API_KEY=replace-with-ctrip-wendao-key
TRIPAI_BASE_URL=https://wendao-skill-prod.ctrip.com/skill/query
TRIPAI_TIMEOUT=30
BRAVE_SEARCH_API_KEY=
# Optional: BRAVE_SEARCH_API_KEY=replace-with-brave-search-key
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
WEB_RESEARCH_TIMEOUT=10
WEB_RESEARCH_RESULT_COUNT=5
WEB_RESEARCH_OFFICIAL_DOMAINS=
SOURCE_CACHE_TTL_SECONDS=21600
GOOGLE_MAPS_API_KEY=
# Optional: GOOGLE_MAPS_API_KEY=replace-with-google-maps-key
GOOGLE_MAPS_PROXY=
LOG_LEVEL=INFO
POSTGRES_USER=journeygo
POSTGRES_DB=journeygo
# Placeholder only. Replace with a random URL-safe value in the untracked .env.staging file.
POSTGRES_PASSWORD=replace-with-random-staging-password
CELERY_VISIBILITY_TIMEOUT=720
TRIP_TASK_STALE_AFTER=120
TRIP_TASK_RECOVERY_INTERVAL=60
TRIP_TASK_LOCK_TIMEOUT=90
TRIP_TASK_SOFT_TIME_LIMIT=600
TRIP_TASK_HARD_TIME_LIMIT=660
LANGGRAPH_STRICT_MSGPACK=true
## Optional Open-Meteo MCP (non-commercial public API only).
WEATHER_ENABLED=false

# Read-only travel queries. Flight limit is cumulative calls, NOT currency or daily quota.
TRAVEL_TRAIN_ENABLED=false
ONE_CLICK_TRAVEL_ENABLED=false
TRAVEL_HOTEL_ENABLED=false
TRAVEL_FLIGHT_ENABLED=false
ROLLINGGO_API_KEY=
# Example: ROLLINGGO_API_KEY=replace-with-rollinggo-hotel-key
VARIFLIGHT_API_KEY=
# Example: VARIFLIGHT_API_KEY=replace-with-variflight-key
TRAVEL_FLIGHT_CALL_LIMIT=0
